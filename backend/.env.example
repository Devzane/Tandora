# ==============================================================================
# Tandora — Environment Configuration Template
# Copy this file to .env and provide your local credentials.
# Note: Unconfigured integration credentials do NOT prevent application startup;
# credentials are automatically validated on-demand when an integration is invoked.
# ==============================================================================

# Application & Database Settings
DATABASE_PATH=./data/tandora.db
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
EXTENSION_API_SECRET=tandora-secure-local-extension-token
DAILY_SENDING_LIMIT=20
DRY_RUN=true

# AI / LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Email Verification (Reoon)
REOON_API_KEY=

# Outbound & Inbound Email (Zoho Mail)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USERNAME=
ZOHO_SMTP_PASSWORD=
ZOHO_SENDER_EMAIL=
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_IMAP_PORT=993

# Google Sheets Integration
GOOGLE_CREDENTIALS_PATH=
GOOGLE_SHEETS_ID=
